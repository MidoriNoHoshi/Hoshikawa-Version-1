{
  "name": "featherweight-local-wallpaper",
  "version": "1.0.0",
  "description": "Minimal, zero-overhead background wallpaper plugin supporting local vault files and remote URLs via CSS variables.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint .",
    "check": "tsc --noEmit && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MidoriNoHoshi/featherweight-local-wallpaper.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "wallpaper",
    "background"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MidoriNoHoshi/featherweight-local-wallpaper/issues"
  },
  "homepage": "https://github.com/MidoriNoHoshi/featherweight-local-wallpaper#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
