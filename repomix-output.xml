<file path="styles.css">
.markdown-reading-view:before,
.cm-editor:before {
  content: "";
  background-blend-mode: overlay;
  background-repeat: no-repeat;
  background-image: var(--obsidian-editor-background-image);
  background-position: center;
  background-size: cover;
  width: 100%;
  height: 100%;
  position: absolute;
  opacity: var(--obsidian-editor-background-opacity);
  filter: blur(var(--obsidian-editor-background-bluriness, 0px));
  background-color: var(
    --obsidian-editor-background-darkness-overlay,
    rgba(0, 0, 0, 0)
  );
  pointer-events: none;
}

.markdown-reading-view:before,
.cm-editor:before,
.nav-files-container::before {
  transform: translateZ(0);
  will-change: transform;
  contain: strict;
}

.nav-files-container {
  position: relative;
  z-index: 4;
}

.wallpaper-drag-drop {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 100%;
  height: 110px;
  margin: 10px 0 16px 0;
  border: 2px dashed var(--text-muted);
  border-radius: 8px;
  background-color: var(--background-secondary);
  color: var(--text-muted);
  cursor: pointer;
  transition:
    border-color 0.15s ease,
    background-color 0.15s ease,
    color 0.15s ease;
  user-select: none;
}

.wallpaper-drag-drop-plus {
  font-size: 28px;
  line-height: 1;
  font-weight: 300;
}

.wallpaper-drag-drop-text {
  font-size: 0.85em;
  opacity: 0.8;
}

.wallpaper-drag-drop.is-dragover {
  border-color: var(--interactive-accent);
  background-color: var(--background-modifier-hover);
  color: var(--text-normal);
}

.nav-files-container::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: var(--obsidian-nav-background-pos);
  background-size: cover;
  background-position: center;
  z-index: -1;
  background-blend-mode: overlay;
  opacity: var(--obsidian-nav-background-posOpacity);
  filter: blur(var(--obsidian-nav-background-Posblur, 0px));
  pointer-events: none;
}

.nav-header {
  position: relative;
  z-index: 1;
}

.nav-folder-title[data-path="/"] {
  padding-top: 1em;
}

.nav-folder-title-content,
.nav-file-title-content {
  text-shadow: var(--obsidian-nav-text-shadow, none);
}

.nav-folder {
  position: relative;
  z-index: 2;
}
